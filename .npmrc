# Installs go through npmmirror: the subject-matter experts collaborating on
# this project are in mainland China, where registry.npmjs.org is slow.
#
# package-lock.json still records canonical registry.npmjs.org URLs; npm 9+
# rewrites them to this registry on install (replace-registry-host=npmjs), and
# CI overrides the registry back to npmjs. If `npm install` writes mirror URLs
# into the lockfile, run `npm run lockfile:fix` before committing (CI checks).
#
# To use the official registry instead, export
#   npm_config_registry=https://registry.npmjs.org/
# Environment variables override this project file; `npm config set` at user
# level does not.
registry=https://registry.npmmirror.com
